# Copy to .env and fill in. This file is read by `docker compose up` (root-level .env)
# as well as being the template for backend/.env and frontend/.env.local.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# QueryMind uses a managed Postgres (e.g. Neon) rather than a local container —
# no local PostgreSQL install required. Paste your connection string here.
DATABASE_URL=postgresql://user:password@host:5432/analytics_db?sslmode=require

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=1000

CORS_ORIGINS=http://localhost:3000
HISTORY_LIMIT=50

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

NEXT_PUBLIC_API_URL=http://localhost:8000
